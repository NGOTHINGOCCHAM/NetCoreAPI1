@model List<BaiThucHanhSo3.Models.Customer>
<h2 class="mb-4">Danh sách khách hàng</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<a asp-action="Create" class="btn btn-success mb-3">+ Thêm khách hàng</a>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Tên khách hàng</th><th>Điện thoại</th><th>Email</th><th>Địa chỉ</th><th>Hành động</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="Orders" asp-route-id="@item.Id" class="btn btn-info btn-sm">Đơn hàng</a>
                    <a asp-action="Edit"   asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
