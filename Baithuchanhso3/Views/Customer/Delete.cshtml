@model BaiThucHanhSo3.Models.Customer
<h2 class="text-danger">Xoá khách hàng</h2>
<div class="alert alert-danger">Bạn có chắc muốn xoá khách hàng <strong>@Model.FullName</strong> không?</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Xoá</button>
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
</form>
