@model BaiThucHanhSo3.Models.Customer
<h2 class="mb-2">Đơn hàng của: <span class="text-primary">@Model.FullName</span></h2>
<a asp-action="Index" class="btn btn-secondary mb-3">← Quay lại</a>
<a asp-controller="Order" asp-action="Create" class="btn btn-success mb-3">+ Tạo đơn hàng mới</a>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">Khách hàng này chưa có đơn hàng nào.</div>
}
else
{
    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between">
                <strong>Đơn hàng #@order.Id - @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in order.OrderDetails)
                        {
                            <tr>
                                <td>@detail.Product?.ProductName</td>
                                <td>@detail.Quantity</td>
                                <td>@detail.UnitPrice.ToString("N0") đ</td>
                                <td>@detail.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}
