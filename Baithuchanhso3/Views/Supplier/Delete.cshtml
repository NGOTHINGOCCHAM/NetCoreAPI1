@model BaiThucHanhSo3.Models.Supplier
<h2 class="text-danger">Xoá nhà cung cấp</h2>
<div class="alert alert-danger">Bạn có chắc muốn xoá nhà cung cấp <strong>@Model.SupplierName</strong> không?</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Xoá</button>
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
</form>
