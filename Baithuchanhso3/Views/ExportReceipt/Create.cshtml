@model BaiThucHanhSo3.Models.ExportReceipt
<h2>Tạo phiếu xuất kho</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="RecipientName" class="form-label">Người nhận</label>
        <input asp-for="RecipientName" class="form-control" placeholder="Nhập tên người nhận" />
    </div>
    <div class="mb-3">
        <label asp-for="ExportDate" class="form-label">Ngày xuất</label>
        <input asp-for="ExportDate" class="form-control" type="datetime-local" />
    </div>
    <div class="mb-3">
        <label asp-for="Note" class="form-label">Ghi chú</label>
        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
    </div>
    <button class="btn btn-primary">Tạo phiếu & thêm thiết bị</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
