@model List<BaiThucHanhSo3.Models.Device>
<h2 class="mb-4">Danh sách thiết bị</h2>
@if (TempData["Success"] != null)
{ <div class="alert alert-success">@TempData["Success"]</div> }
<form asp-action="Index" method="get" class="d-flex gap-2 mb-3 flex-wrap">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width:250px" placeholder="Tìm tên/mã thiết bị..." />
    <select name="deviceTypeId" asp-items="ViewBag.DeviceTypes" class="form-select" style="max-width:200px">
        <option value="">-- Tất cả loại --</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Xoá lọc</a>
</form>
<a asp-action="Create" class="btn btn-success mb-3">+ Thêm thiết bị</a>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Mã</th><th>Tên thiết bị</th><th>Loại</th><th>Tồn kho</th><th>Hành động</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.DeviceCode</td>
                <td>@item.DeviceName</td>
                <td>@item.DeviceType?.TypeName</td>
                <td>
                    <span class="badge @(item.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                        @item.StockQuantity
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
