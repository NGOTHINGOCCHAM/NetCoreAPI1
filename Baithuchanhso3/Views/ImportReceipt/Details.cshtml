@model BaiThucHanhSo3.Models.ImportReceipt
<h2 class="mb-1">Phiếu nhập kho #@Model.Id</h2>
<p class="text-muted">NCC: <strong>@Model.Supplier?.SupplierName</strong> &nbsp;|&nbsp; Ngày: @Model.ImportDate.ToString("dd/MM/yyyy HH:mm")</p>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div>   }

<div class="row">
    <div class="col-md-8">
        <h5>Thiết bị trong phiếu nhập</h5>
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr><th>Thiết bị</th><th>Loại</th><th>SL</th><th>Đơn giá nhập</th><th>Thành tiền</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.ImportDetails)
                {
                    <tr>
                        <td>@detail.Device?.DeviceName</td>
                        <td>@detail.Device?.DeviceType?.TypeName</td>
                        <td>@detail.Quantity</td>
                        <td>@detail.ImportPrice.ToString("N0") đ</td>
                        <td>@detail.LineTotal.ToString("N0") đ</td>
                        <td>
                            <form asp-action="RemoveDetail" method="post" style="display:inline">
                                <input type="hidden" name="detailId" value="@detail.Id" />
                                <input type="hidden" name="receiptId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xoá thiết bị này?')">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary">
                <tr><td colspan="4" class="text-end fw-bold">Tổng cộng:</td><td colspan="2" class="fw-bold text-success fs-5">@Model.TotalAmount.ToString("N0") đ</td></tr>
            </tfoot>
        </table>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Thêm thiết bị vào phiếu</h5>
            <form asp-action="AddDetail" method="post">
                <input type="hidden" name="receiptId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">Thiết bị</label>
                    <select name="deviceId" asp-items="ViewBag.Devices" class="form-select"><option value="">-- Chọn thiết bị --</option></select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Số lượng nhập</label>
                    <input name="quantity" type="number" min="1" value="1" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Đơn giá nhập (đ)</label>
                    <input name="importPrice" type="number" min="0" step="1000" value="0" class="form-control" />
                </div>
                <button class="btn btn-primary w-100">Thêm vào phiếu</button>
            </form>
        </div>
        <a asp-action="Index" class="btn btn-secondary mt-2 w-100">← Danh sách phiếu nhập</a>
    </div>
</div>
