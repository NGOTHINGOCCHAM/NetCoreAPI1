@model List<BaiThucHanhSo3.Models.Product>
<h2 class="mb-4">Danh sách sản phẩm</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<a asp-action="Create" class="btn btn-success mb-3">+ Thêm sản phẩm</a>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Tên sản phẩm</th><th>Đơn giá</th><th>Mô tả</th><th>Hành động</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ProductName</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit"   asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
