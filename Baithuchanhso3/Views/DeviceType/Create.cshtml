@model BaiThucHanhSo3.Models.DeviceType
<h2>Thêm loại thiết bị</h2>
<form asp-action="Create" method="post">
    <div class="mb-3"><label asp-for="TypeName" class="form-label"></label><input asp-for="TypeName" class="form-control" /><span asp-validation-for="TypeName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
