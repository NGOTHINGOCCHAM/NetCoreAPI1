<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BaiThucHanh</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BaiThucHanhSo3.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    BaiThucHanh
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @* Buổi 8: Sinh viên & Khoa *@
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                Buổi 8
                            </a>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Sinh viên</h6></li>
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="Index">Danh sách SV</a></li>
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="Create">Thêm sinh viên</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Khoa</h6></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Index">Danh sách khoa</a></li>
                                <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Create">Thêm khoa</a></li>
                            </ul>
                        </li>

                        @* Buổi 9: Bán hàng *@
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                Buổi 9
                            </a>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Khách hàng</h6></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index">Danh sách KH</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Sản phẩm</h6></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Danh sách SP</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Đơn hàng</h6></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">Danh sách đơn</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Create">Tạo đơn hàng</a></li>
                            </ul>
                        </li>

                        @* Buổi 10: Import Excel *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Import" asp-action="Index">Buổi 10</a>
                        </li>

                        @* Buổi 12: Quản lý kho *@
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                Buổi 12
                            </a>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Danh mục</h6></li>
                                <li><a class="dropdown-item" asp-controller="Supplier"   asp-action="Index">Nhà cung cấp</a></li>
                                <li><a class="dropdown-item" asp-controller="DeviceType" asp-action="Index">Loại thiết bị</a></li>
                                <li><a class="dropdown-item" asp-controller="Device"     asp-action="Index">Thiết bị</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Kho</h6></li>
                                <li><a class="dropdown-item" asp-controller="ImportReceipt" asp-action="Index">Phiếu nhập kho</a></li>
                                <li><a class="dropdown-item" asp-controller="ExportReceipt" asp-action="Index">Phiếu xuất kho</a></li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <h3 class="mb-3">@ViewData["Title"]</h3>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BaiThucHanhSo3 - Ngo Thi Ngoc Cham - 21210508888
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="liveToast" class="toast align-items-center text-bg-success border-0">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        var toastEl = document.getElementById('liveToast');
        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
