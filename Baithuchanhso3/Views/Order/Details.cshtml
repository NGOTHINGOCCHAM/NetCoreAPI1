@model BaiThucHanhSo3.Models.Order
<h2 class="mb-1">Chi tiết đơn hàng #@Model.Id</h2>
<p class="text-muted">Khách hàng: <strong>@Model.Customer?.FullName</strong> &nbsp;|&nbsp; Ngày: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
@if (!string.IsNullOrEmpty(Model.Note))
{
    <p><em>Ghi chú: @Model.Note</em></p>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-8">
        <h5>Sản phẩm trong đơn</h5>
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td>@detail.Product?.ProductName</td>
                        <td>@detail.Quantity</td>
                        <td>@detail.UnitPrice.ToString("N0") đ</td>
                        <td>@detail.LineTotal.ToString("N0") đ</td>
                        <td>
                            <form asp-action="RemoveDetail" method="post" style="display:inline">
                                <input type="hidden" name="detailId" value="@detail.Id" />
                                <input type="hidden" name="orderId"  value="@Model.Id"  />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Xoá sản phẩm này khỏi đơn?')">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary">
                <tr>
                    <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                    <td colspan="2" class="fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h5>Thêm sản phẩm vào đơn</h5>
            <form asp-action="AddDetail" method="post">
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">Sản phẩm</label>
                    <select name="productId" asp-items="ViewBag.Products" class="form-select">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Số lượng</label>
                    <input name="quantity" type="number" min="1" value="1" class="form-control" />
                </div>
                <button class="btn btn-primary w-100">Thêm vào đơn</button>
            </form>
        </div>
        <a asp-action="Index" class="btn btn-secondary mt-2 w-100">← Danh sách đơn hàng</a>
    </div>
</div>
